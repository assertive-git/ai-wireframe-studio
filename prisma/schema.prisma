generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String    @id @default(cuid())
  name             String
  pageType         String
  concept          String    @db.Text
  target           String    @db.Text
  primaryAppeal    String    @db.Text
  mustInclude      String    @db.Text
  designDirections Json
  referenceUrls    Json
  referenceMode    String
  hearingSummary   Json?
  currentHtml      String?   @db.LongText
  currentCss       String?   @db.LongText
  status           String    @default("intake")
  shareToken       String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assets           Asset[]
  messages         Message[]
  versions         Version[]
}

model Asset {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  mimeType      String
  url           String   @db.Text
  rights        String   @default("usable")
  sourceUrl     String?  @db.Text
  extractedText String?  @db.LongText
  createdAt     DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.LongText
  kind      String   @default("chat")
  createdAt DateTime @default(now())
}

model Version {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  html          String   @db.LongText
  css           String   @db.LongText
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@unique([projectId, versionNumber])
}